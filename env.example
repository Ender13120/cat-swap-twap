# Environment Variables for cat-swap-twap
# Copy this file to .env and fill in your actual values

# 1inch API Key (get from https://portal.1inch.dev/)
ONEINCH_API_KEY=your_1inch_api_key_here

# Private Keys (keep these secret!)
# Main user private key (used in Solidity scripts: RegisterBatchSwap.s.sol, ExecuteRealSwapAuto.s.sol)
USER_PK=0xYOUR_PRIVATE_KEY_HERE

# Test user private key for TypeScript scripts (used in: scripts/submit-1inch-orders.ts)
USER_PK2=0xYOUR_TEST_USER_PRIVATE_KEY_HERE

# Executor private key (used in: scripts/submit-1inch-orders.ts)
EXECUTOR_PK=0xYOUR_EXECUTOR_PRIVATE_KEY_HERE

# Sponsor private key (used in: ExecuteBatchPart.s.sol, scripts/submit-live-twap.ts)
SPONSOR_PK=0xYOUR_SPONSOR_PRIVATE_KEY_HERE

# TWAP live user private key (used in: scripts/submit-live-twap.ts)
TWAP_LIVE_USER_PK=0xYOUR_TWAP_USER_PRIVATE_KEY_HERE

# RPC URLs (optional - defaults are provided in scripts)
RPC_URL=https://mainnet.optimism.io
ALCHEMY_RPC_URL=https://opt-mainnet.g.alchemy.com/v2/your_alchemy_key_here

# Contract Addresses (optional - defaults are provided in scripts)
DELEGATED_WALLET_ADDRESS=0xa11cCD98850c568eA86d964dabE7afeB085b7DFe
IMPLEMENTATION_ADDRESS=0x6B90FAF6d634EDE2E56c024A9b852A9607a5c7bf

# Note: These are well-known test private keys from Hardhat
# NEVER use these in production or with real funds! 